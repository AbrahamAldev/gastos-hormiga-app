# ─────────────────────────────────────────────────────────────
#  Configuración de Gastos Hormiga
#  1. Copia este archivo:      cp .env.example .env
#  2. Define tu clave de referido y llena SOLO el bloque del proveedor de IA que vas a usar.
#  3. El archivo .env está en .gitignore: tus claves no se suben a GitHub.
#  4. Los cambios se aplican al volver a desplegar (npx ampx sandbox --once).
#
#  En Amplify Hosting no existe el .env: agrega las mismas variables en
#  la consola de Amplify → tu app → Hosting → Environment variables.
# ─────────────────────────────────────────────────────────────

# ── Registro con clave de referido ───────────────────────────
# Sólo quien escriba esta clave puede crear una cuenta (no distingue mayúsculas).
# Vacía = registro abierto para cualquiera. Para generar una clave aleatoria:
#   node -e "console.log('HRM-'+require('crypto').randomBytes(6).toString('base64url').toUpperCase())"
# Si se filtra, cámbiala aquí y vuelve a desplegar: la anterior deja de funcionar.
SIGNUP_REFERRAL_CODE=

# ── Coach con IA ─────────────────────────────────────────────
# Preguntas al Coach por usuario y por día (hora de la Ciudad de México). Por defecto: 25.
COACH_DAILY_LIMIT=25

# Proveedor: bedrock | openrouter | gemini | ollama | openai
COACH_PROVIDER=bedrock

# Modelo. Con bedrock es opcional (por defecto: us.amazon.nova-lite-v1:0).
# Con cualquier otro proveedor es obligatorio. El modelo debe soportar herramientas (tool calling).
COACH_MODEL=

# ── OpenRouter (https://openrouter.ai/keys) ──────────────────
# Ejemplo de modelo: el identificador que aparece en openrouter.ai/models
OPENROUTER_API_KEY=

# ── Google AI Studio / Gemini (https://aistudio.google.com/apikey) ──
# Ejemplo de modelo: el nombre de un modelo Gemini de tu panel de AI Studio
GEMINI_API_KEY=

# ── Ollama ───────────────────────────────────────────────────
# Debe ser una URL accesible desde internet que termine en /v1 (ej. https://mi-servidor.com/v1).
# "localhost" NO funciona: el Coach corre en AWS Lambda, no en tu computadora.
OLLAMA_BASE_URL=
# Sólo si tu servidor de Ollama exige clave
OLLAMA_API_KEY=

# ── OpenAI u otra API compatible con OpenAI ─────────────────
OPENAI_API_KEY=
# Opcional: URL de otra API compatible (ej. Groq, DeepSeek, Together). Vacío = OpenAI.
OPENAI_BASE_URL=
